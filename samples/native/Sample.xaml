<!-- WSL Control Panel - NATIVE (WPF) SAMPLE. Colours are brushes in
     Window.Resources and every control uses them through DynamicResource, so
     Sample.ps1 can switch the whole window between dark and light. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Control Panel" Width="1200" Height="780" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13.5">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0F1115"/>
    <SolidColorBrush x:Key="Sidebar" Color="#14171D"/>
    <SolidColorBrush x:Key="Card" Color="#1A1E26"/>
    <SolidColorBrush x:Key="Raised" Color="#232935"/>
    <SolidColorBrush x:Key="Line" Color="#2A303C"/>
    <SolidColorBrush x:Key="Text" Color="#E8EAEF"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A3"/>
    <SolidColorBrush x:Key="Accent" Color="#4FB6FF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#04121F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3448"/>
    <SolidColorBrush x:Key="Ok" Color="#3CCF91"/>
    <SolidColorBrush x:Key="OkSoft" Color="#173A2E"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1F24"/>
    <SolidColorBrush x:Key="LogBg" Color="#0A0C10"/>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Danger}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Text inputs -->
    <Style x:Key="Input" TargetType="Control">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Ellipse x:Name="knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Progress bar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Raised}"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4FB6FF" Offset="0"/>
                    <GradientStop Color="#7C5CFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows of the distro list in the sidebar -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="10" Padding="8,7" Margin="0,2" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,22,0,10"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============================ Sidebar ============================ -->
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
          <Border Width="36" Height="36" CornerRadius="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4FB6FF" Offset="0"/>
                <GradientStop Color="#7C5CFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&gt;_" Foreground="White" FontFamily="Consolas" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="WSL Control Panel" FontWeight="SemiBold"/>
            <TextBlock Text="v2.0 &#183; native sample" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="YOUR DISTROS" Foreground="{DynamicResource Muted}" FontSize="11"
                   FontWeight="SemiBold" Margin="8,0,0,6"/>

        <!-- bottom part of the sidebar -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource CardBox}" Padding="12" CornerRadius="12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="WslDot" Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                <TextBlock x:Name="WslState" Text="WSL is running" FontWeight="SemiBold" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="WslMem" Text="1 of 3 distros on" Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
              <Button x:Name="BtnShutdown" Style="{StaticResource Small}" Content="Shut down all" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnTheme" Style="{StaticResource Small}" Content="Switch to light theme" Margin="0,10,0,0"/>
        </StackPanel>

        <Button x:Name="BtnDownload" DockPanel.Dock="Bottom" Style="{StaticResource Primary}"
                Content="+  Download a distro" Margin="0,12,0,14"/>

        <ListBox x:Name="DistroList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Text}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="{Binding Color}">
                  <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Pretty}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ============================ Distro page ============================ -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="36,30,36,40" MaxWidth="1000">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="HeroAvatar" Width="64" Height="64" CornerRadius="16" Background="#E95420">
            <TextBlock x:Name="HeroInitial" Text="U" Foreground="White" FontWeight="Bold" FontSize="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HeroName" Text="Ubuntu 24.04 LTS" FontSize="24" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Border x:Name="StatePill" CornerRadius="10" Padding="9,2" Background="{DynamicResource OkSoft}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StateText" Text="Running" Foreground="{DynamicResource Ok}" FontSize="12"
                             FontWeight="SemiBold" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="HeroId" Text="Ubuntu-24.04" FontFamily="Consolas" Foreground="{DynamicResource Muted}"
                         FontSize="12" Margin="10,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnStartStop" Style="{StaticResource Btn}" Content="Stop" Margin="0,0,10,0"/>
            <Button x:Name="BtnTerminal" Style="{StaticResource Btn}" Content="Terminal" Margin="0,0,10,0"/>
            <Button x:Name="BtnDesktop" Style="{StaticResource Primary}" Content="Open desktop"/>
          </StackPanel>
        </Grid>

        <UniformGrid Columns="4" Margin="0,22,0,0">
          <Border Style="{StaticResource CardBox}" Margin="0,0,6,0" Padding="14,12">
            <StackPanel><TextBlock Text="Disk" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="StatDisk" Text="12.3 GB" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="14,12">
            <StackPanel><TextBlock Text="Desktop port" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="StatPort" Text="3390" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="6,0" Padding="14,12">
            <StackPanel><TextBlock Text="Default login" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="StatUser" Text="shreyas" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="6,0,0,0" Padding="14,12">
            <StackPanel><TextBlock Text="WSL version" Style="{StaticResource MutedText}"/>
              <TextBlock Text="2" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
        </UniformGrid>

        <!-- Accounts -->
        <DockPanel>
          <Button x:Name="BtnAddUser" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="+  Add a user"
                  VerticalAlignment="Bottom" Margin="0,0,0,10"/>
          <TextBlock Text="Accounts" Style="{StaticResource H2}"/>
        </DockPanel>
        <Border Style="{StaticResource CardBox}" Padding="6">
          <StackPanel>
            <TextBlock x:Name="NoUsers" Margin="10" Style="{StaticResource MutedText}" Visibility="Collapsed"
                       Text="No user yet - only root, which cannot log in to a desktop."/>
            <ItemsControl x:Name="AccountList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}">
                      <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Accent}" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="Admin (sudo) &#183; password saved, encrypted" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Style="{StaticResource Small}" Content="Change password" Tag="{Binding Name}" Margin="0,0,8,0"/>
                      <Button Style="{StaticResource Small}" Content="Remove" Tag="{Binding Name}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Settings -->
        <TextBlock Text="Settings" Style="{StaticResource H2}"/>
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <DockPanel>
              <TextBox x:Name="PortBox" DockPanel.Dock="Right" Width="100" Text="3390" Margin="0"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Remote Desktop port" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Each distro can have its own, so two desktops can be open at once."/></StackPanel>
            </DockPanel>
            <Separator Margin="0,12" Background="{DynamicResource Line}"/>
            <DockPanel>
              <CheckBox x:Name="SystemdSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="systemd" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Starts services (Docker, SSH, databases) properly. Applies after the distro restarts."/></StackPanel>
            </DockPanel>
            <Separator Margin="0,12" Background="{DynamicResource Line}"/>
            <DockPanel>
              <Button x:Name="BtnCompact" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Compact" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Compact disk" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Gives unused space in ext4.vhdx back to Windows."/></StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Danger zone -->
        <TextBlock Text="Danger zone" Style="{StaticResource H2}"/>
        <Border Style="{StaticResource CardBox}" BorderBrush="{DynamicResource Danger}">
          <DockPanel>
            <Button x:Name="BtnDelete" DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Content="Delete" VerticalAlignment="Center"/>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="Delete this distro" FontWeight="SemiBold"/>
              <TextBlock x:Name="DeleteHint" Style="{StaticResource MutedText}" Text="Erases it and every file inside. Back it up first if you might need it."/></StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ============================ Dialog overlay ============================ -->
    <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#A6050810">
      <Border x:Name="DialogCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="16" Padding="24" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <!-- Create user -->
          <StackPanel x:Name="PanelUser" Visibility="Collapsed">
            <TextBlock Text="Create your Linux user" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="UserIntro" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,14"/>
            <TextBlock Text="Username" FontWeight="SemiBold"/>
            <TextBox x:Name="UName" Text="shreyas"/>
            <TextBlock x:Name="UHint" Style="{StaticResource MutedText}" Text="Lowercase letters, digits, - and _"/>
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <PasswordBox x:Name="P1"/>
            <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <PasswordBox x:Name="P2"/>
            <TextBlock x:Name="PHint" Style="{StaticResource MutedText}" Text=" "/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnUserCancel" Style="{StaticResource Btn}" Content="Not now" Margin="0,0,10,0"/>
              <Button x:Name="BtnUserOk" Style="{StaticResource Primary}" Content="Create user" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Long task with progress -->
          <StackPanel x:Name="PanelTask" Visibility="Collapsed">
            <TextBlock x:Name="TaskTitle" Text="Working" FontSize="18" FontWeight="SemiBold"/>
            <DockPanel Margin="0,10,0,6">
              <TextBlock x:Name="TaskPct" DockPanel.Dock="Right" Text="0%" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="TaskStep" Text="Starting..." Style="{StaticResource MutedText}"/>
            </DockPanel>
            <ProgressBar x:Name="TaskBar" Maximum="100" Value="0"/>
            <TextBox x:Name="TaskLog" Height="190" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                     Background="{DynamicResource LogBg}" Foreground="#B7C0CF" BorderThickness="0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="BtnTaskClose" Style="{StaticResource Btn}" Content="Working..." IsEnabled="False"
                    HorizontalAlignment="Right" Margin="0,14,0,0"/>
          </StackPanel>

          <!-- Delete confirmation -->
          <StackPanel x:Name="PanelDelete" Visibility="Collapsed">
            <TextBlock x:Name="DelTitle" Text="Delete?" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="{DynamicResource DangerSoft}" CornerRadius="10" Padding="12,10" Margin="0,12,0,14">
              <TextBlock Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="13"
                         Text="This permanently erases the distro and ALL files inside it. It cannot be undone."/>
            </Border>
            <TextBlock x:Name="DelLabel" FontWeight="SemiBold" Text="Type the name to confirm"/>
            <TextBox x:Name="DelName" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnDelCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnDelOk" Style="{StaticResource DangerBtn}" Content="Delete forever" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Download picker -->
          <StackPanel x:Name="PanelDownload" Visibility="Collapsed">
            <TextBlock Text="Download a Linux distro" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,12"
                       Text="From Microsoft's official list. The download is resumable and checked before it is installed."/>
            <ListBox x:Name="OnlineList" Height="290" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{Binding Color}">
                      <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Pretty}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button x:Name="BtnDlCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnDlOk" Style="{StaticResource Primary}" Content="Download" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Toast -->
    <Border x:Name="Toast" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,20" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Ok}" BorderThickness="4,1,1,1"
            CornerRadius="10" Padding="14,10" MinWidth="260">
      <TextBlock x:Name="ToastText" Text=""/>
    </Border>
  </Grid>
</Window>
