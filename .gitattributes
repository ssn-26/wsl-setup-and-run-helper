# Keep Windows batch files byte-for-byte, with their Windows (CRLF) line
# endings - in this repo AND in GitHub downloads. cmd.exe can fail to find
# goto/call labels in .bat files that use Unix (LF) line endings.
# "-text" tells Git never to convert line endings for these files.
*.bat -text

# Shell scripts are run by bash inside WSL, so they must always be LF.
*.sh text eol=lf
# Everything in bash/ goes into Linux (e.g. the xsession file), so LF too.
bash/** text eol=lf

# PowerShell script: LF on disk. Keep it plain ASCII - Windows PowerShell 5.1
# reads a BOM-less file as ANSI, so non-ASCII characters could break parsing.
*.ps1 text eol=lf

# Config and account data files stay LF.
*.json text eol=lf
*.acct text eol=lf

# GitHub-only files: left out of "Download ZIP" (and of what install.ps1
# downloads), so people get only what the app needs.
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
README.md export-ignore
LICENSE export-ignore
installer/ export-ignore
docs/ export-ignore
CHANGELOG.md export-ignore
