<!-- WSL Control Panel - the window. Colours are brushes in Window.Resources and
     every control uses them through DynamicResource, so the panel can switch the
     whole window between dark and light. Every x:Name is reachable from
     WSL-Control-Panel.ps1 as $ui.<Name>. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Control Panel" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13.5">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0F1115"/>
    <SolidColorBrush x:Key="Sidebar" Color="#14171D"/>
    <SolidColorBrush x:Key="Card" Color="#1A1E26"/>
    <SolidColorBrush x:Key="Raised" Color="#232935"/>
    <SolidColorBrush x:Key="Line" Color="#2A303C"/>
    <SolidColorBrush x:Key="Text" Color="#E8EAEF"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A3"/>
    <SolidColorBrush x:Key="Accent" Color="#4FB6FF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#04121F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3448"/>
    <SolidColorBrush x:Key="Ok" Color="#3CCF91"/>
    <SolidColorBrush x:Key="OkSoft" Color="#173A2E"/>
    <SolidColorBrush x:Key="Warn" Color="#F5B84A"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1F24"/>
    <SolidColorBrush x:Key="LogBg" Color="#0A0C10"/>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Danger}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Text inputs -->
    <Style x:Key="Input" TargetType="Control">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Ellipse x:Name="knob" Width="16" Height="16" Margin="2,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Progress bar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Raised}"/>
              <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4FB6FF" Offset="0"/>
                    <GradientStop Color="#7C5CFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rows of the distro list in the sidebar -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="10" Padding="8,7" Margin="0,2" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- "Open as" choices: small pills in a row -->
    <Style x:Key="Chip" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="14" Padding="12,5" Margin="0,0,8,6" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,22,0,10"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============================ Sidebar ============================ -->
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
          <Border Width="36" Height="36" CornerRadius="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4FB6FF" Offset="0"/>
                <GradientStop Color="#7C5CFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&gt;_" Foreground="White" FontFamily="Consolas" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="WSL Control Panel" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Text="v2.0.0" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </StackPanel>

        <Button x:Name="BtnQuickOpen" DockPanel.Dock="Top" Style="{StaticResource Primary}" Content="Open default desktop"
                Margin="0,0,0,16" ToolTip="Opens the desktop of your default distro with its first saved account"/>

        <TextBlock DockPanel.Dock="Top" Text="YOUR DISTROS" Foreground="{DynamicResource Muted}" FontSize="11"
                   FontWeight="SemiBold" Margin="8,0,0,6"/>

        <!-- bottom part of the sidebar -->
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="BtnDownload" Style="{StaticResource Primary}" Content="+  Download a distro" Margin="0,10,0,12"/>
          <TextBlock Text="TOOLS" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,6"/>
          <UniformGrid Columns="2">
            <Button x:Name="BtnBackup"   Style="{StaticResource Small}" Content="Back up"          Margin="0,0,4,6"/>
            <Button x:Name="BtnRestore"  Style="{StaticResource Small}" Content="Restore"          Margin="4,0,0,6"/>
            <Button x:Name="BtnCloseRun" Style="{StaticResource Small}" Content="Close running"    Margin="0,0,4,6"/>
            <Button x:Name="BtnShutdown" Style="{StaticResource Small}" Content="Shut down all"    Margin="4,0,0,6"/>
            <Button x:Name="BtnCompactAny" Style="{StaticResource Small}" Content="Compact a disk" Margin="0,0,4,6"/>
            <Button x:Name="BtnLimits"   Style="{StaticResource Small}" Content="Memory / CPU"     Margin="4,0,0,6"/>
            <Button x:Name="BtnFolders"  Style="{StaticResource Small}" Content="Data folders"     Margin="0,0,4,6"/>
            <Button x:Name="BtnUpdate"   Style="{StaticResource Small}" Content="Update WSL"       Margin="4,0,0,6"/>
          </UniformGrid>
          <Button x:Name="BtnTheme" Style="{StaticResource Small}" Content="Switch to light theme" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock x:Name="HiddenNote" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="8,6,8,0" Visibility="Collapsed"/>

        <Grid>
          <TextBlock x:Name="NoDistros" Style="{StaticResource MutedText}" Margin="8,4" Visibility="Collapsed"
                     Text="None yet - use Download a distro below to get your first one."/>
          <ListBox x:Name="DistroList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Text}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Raised}">
                    <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ============================ Distro page ============================ -->
    <TextBlock x:Name="EmptyPage" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
               Text="Pick a distro on the left, or download your first one."/>
    <ScrollViewer x:Name="DistroPage" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="36,30,36,40" MaxWidth="1000">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Raised}">
            <TextBlock x:Name="HeroInitial" Text="U" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="HeroName" Text="Ubuntu" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Border x:Name="StatePill" CornerRadius="10" Padding="9,2" Background="{DynamicResource Raised}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StateText" Text="Stopped" Foreground="{DynamicResource Muted}" FontSize="12"
                             FontWeight="SemiBold" Margin="6,0,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="HeroMeta" Text="WSL 2 - default" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnClose" Style="{StaticResource Btn}" Content="Close" Margin="0,0,10,0"
                    ToolTip="wsl --terminate: stops this distro and frees its RAM"/>
            <Button x:Name="BtnTerminal" Style="{StaticResource Btn}" Content="Terminal" Margin="0,0,10,0"/>
            <Button x:Name="BtnDesktop" Style="{StaticResource Primary}" Content="Open desktop"/>
          </StackPanel>
        </Grid>

        <!-- which saved login to open with -->
        <StackPanel x:Name="OpenAsRow" Orientation="Horizontal" Margin="82,14,0,0">
          <TextBlock Text="Open as" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ListBox x:Name="OpenAsList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Chip}"
                   Foreground="{DynamicResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </StackPanel>

        <UniformGrid Columns="2" Margin="0,20,0,0">
          <Border Style="{StaticResource CardBox}" Margin="0,0,6,0" Padding="14,12">
            <StackPanel><TextBlock Text="Disk size" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="StatDisk" Text="0 GB" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
          <Border Style="{StaticResource CardBox}" Margin="6,0,0,0" Padding="14,12">
            <StackPanel><TextBlock Text="Remote Desktop (xrdp) port" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="StatPort" Text="3390" FontSize="16" FontWeight="SemiBold"/></StackPanel>
          </Border>
        </UniformGrid>

        <!-- Accounts -->
        <DockPanel>
          <Button x:Name="BtnAddUser" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="+  Add an account"
                  VerticalAlignment="Bottom" Margin="0,0,0,10"/>
          <TextBlock Text="Saved accounts (used for auto-login)" Style="{StaticResource H2}"/>
        </DockPanel>
        <Border Style="{StaticResource CardBox}" Padding="6">
          <StackPanel>
            <TextBlock x:Name="NoUsers" Margin="10" Style="{StaticResource MutedText}" Visibility="Collapsed"
                       Text="None saved yet. On a fresh distro, opening the desktop offers to create your user."/>
            <ItemsControl x:Name="AccountList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}">
                      <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Accent}" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="Password saved here, encrypted with Windows DPAPI" Foreground="{DynamicResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Style="{StaticResource Small}" Content="Change password" Tag="{Binding Name}" Margin="0,0,8,0"/>
                      <Button Style="{StaticResource Small}" Content="Remove" Tag="{Binding Name}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Settings -->
        <TextBlock Text="Settings" Style="{StaticResource H2}"/>
        <Border Style="{StaticResource CardBox}">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PortBox" Width="90" Text="3390" Margin="0"/>
                <Button x:Name="BtnPortSave" Style="{StaticResource Small}" Content="Save" Margin="8,0,0,0"/>
              </StackPanel>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Remote Desktop port" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="1024-65535. Each distro can have its own, so two desktops can be open at once. Used the next time you open the desktop."/></StackPanel>
            </DockPanel>
            <Separator Margin="0,12" Background="{DynamicResource Line}"/>
            <DockPanel>
              <Button x:Name="BtnSystemd" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Turn on / off..." VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="systemd" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="The standard Linux service manager: with it on, services (Docker, SSH, cron, databases) start properly. Set in /etc/wsl.conf."/></StackPanel>
            </DockPanel>
            <Separator Margin="0,12" Background="{DynamicResource Line}"/>
            <DockPanel>
              <Button x:Name="BtnCompact" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Compact..." VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Compact disk" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Gives unused ext4.vhdx space back to Windows."/></StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Danger zone -->
        <TextBlock Text="Danger zone" Style="{StaticResource H2}"/>
        <Border Style="{StaticResource CardBox}" BorderBrush="{DynamicResource Danger}">
          <DockPanel>
            <Button x:Name="BtnDelete" DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Content="Delete..." VerticalAlignment="Center"/>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="Delete this distro" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource MutedText}" Text="&quot;wsl --unregister&quot;: ERASES it and every file inside (permanent!). Back it up first if you might need it."/></StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ============================ Dialog overlay ============================ -->
    <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#A6050810">
      <Border x:Name="DialogCard" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="16" Padding="24" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <!-- Message / question with up to three buttons -->
          <StackPanel x:Name="PanelMessage" Visibility="Collapsed">
            <TextBlock x:Name="MsgTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <TextBlock x:Name="MsgText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="MsgB3" Style="{StaticResource Btn}" Margin="0,0,10,0"/>
              <Button x:Name="MsgB2" Style="{StaticResource Btn}" Margin="0,0,10,0"/>
              <Button x:Name="MsgB1" Style="{StaticResource Primary}"/>
            </StackPanel>
          </StackPanel>

          <!-- Username + password (first user, add account, re-create, change password) -->
          <StackPanel x:Name="PanelUser" Visibility="Collapsed">
            <TextBlock x:Name="UserTitle" Text="Create your Linux user" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="UserIntro" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,14"/>
            <TextBlock Text="Linux username" FontWeight="SemiBold"/>
            <TextBox x:Name="UName"/>
            <TextBlock x:Name="UHint" Style="{StaticResource MutedText}" Text="Lowercase letters, digits, - and _, starting with a letter"/>
            <DockPanel x:Name="CreateRow" Margin="0,12,0,0">
              <CheckBox x:Name="CreateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="True"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Also create this user inside the distro" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource MutedText}" Text="On: fresh distro / new user - makes the Linux user with admin (sudo) rights and the desktop session. Off: the Linux user already exists; only remember the login here."/></StackPanel>
            </DockPanel>
            <TextBlock x:Name="P1Label" Text="Password" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <PasswordBox x:Name="P1"/>
            <TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <PasswordBox x:Name="P2"/>
            <TextBlock x:Name="PHint" Style="{StaticResource MutedText}" Text=" "/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnUserCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnUserOk" Style="{StaticResource Primary}" Content="Create user" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Long task with live output -->
          <StackPanel x:Name="PanelTask" Visibility="Collapsed">
            <TextBlock x:Name="TaskTitle" Text="Working" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <DockPanel Margin="0,10,0,6">
              <TextBlock x:Name="TaskTime" DockPanel.Dock="Right" Text="0:00" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
              <TextBlock x:Name="TaskStep" Text="Starting..." Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
            <ProgressBar x:Name="TaskBar" Maximum="100" Value="0"/>
            <TextBox x:Name="TaskLog" Height="220" Margin="0,12,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                     Background="{DynamicResource LogBg}" Foreground="#B7C0CF" BorderThickness="0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
          </StackPanel>

          <!-- Delete confirmation -->
          <StackPanel x:Name="PanelDelete" Visibility="Collapsed">
            <TextBlock x:Name="DelTitle" Text="Delete?" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="{DynamicResource DangerSoft}" CornerRadius="10" Padding="12,10" Margin="0,12,0,14">
              <TextBlock Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="13"
                         Text="WARNING: this permanently erases the distro and ALL of its files. It cannot be undone."/>
            </Border>
            <TextBlock x:Name="DelLabel" FontWeight="SemiBold" Text="Type the distro name exactly to confirm"/>
            <TextBox x:Name="DelName" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnDelCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnDelOk" Style="{StaticResource DangerBtn}" Content="Delete forever" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Pick one from a list (close a running distro, compact a disk) -->
          <StackPanel x:Name="PanelPick" Visibility="Collapsed">
            <TextBlock x:Name="PickTitle" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="PickText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,12"/>
            <ListBox x:Name="PickList" MaxHeight="260" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="PickB3" Style="{StaticResource Btn}" Margin="0,0,10,0"/>
              <Button x:Name="PickB2" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="PickB1" Style="{StaticResource Primary}" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Download a new distro -->
          <StackPanel x:Name="PanelDownload" Visibility="Collapsed">
            <TextBlock Text="Download a NEW distro" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,12"
                       Text="Pick one from Microsoft's official list (wsl --install), or type its name."/>
            <ListBox x:Name="OnlineList" Height="230" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Friendly}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBox x:Name="DlName" FontFamily="Consolas"/>
            <TextBlock Text="Install into (its own sub-folder is created inside)" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <DockPanel Margin="0,6,0,0">
              <Button x:Name="BtnDlFolder" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change..." Margin="8,0,0,0"/>
              <TextBlock x:Name="DlFolder" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnDlCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnDlOk" Style="{StaticResource Primary}" Content="Download and install" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Back up a distro -->
          <StackPanel x:Name="PanelBackup" Visibility="Collapsed">
            <TextBlock Text="Back up a distro (wsl --export)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,12"
                       Text="A backup holds everything inside the distro: programs, desktop, users and files."/>
            <TextBlock Text="Which distro?" FontWeight="SemiBold"/>
            <ListBox x:Name="BakList" MaxHeight="170" Margin="0,6,0,0" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"/>
            <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <RadioButton x:Name="BakTar" GroupName="fmt" IsChecked="True" Foreground="{DynamicResource Text}" Margin="0,2"
                         Content=".tar - works on any WSL machine"/>
            <RadioButton x:Name="BakVhdx" GroupName="fmt" Foreground="{DynamicResource Text}" Margin="0,2"
                         Content=".vhdx - fastest, an exact copy of the disk"/>
            <TextBlock Text="Save to" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <DockPanel Margin="0,6,0,0">
              <Button x:Name="BtnBakFolder" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change..." Margin="8,0,0,0"/>
              <TextBlock x:Name="BakFolder" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="BakWarn" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" FontSize="12.5" Margin="0,12,0,0"
                       Text="This STOPS the distro first (an open desktop or terminal closes - save your work)."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnBakCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnBakOk" Style="{StaticResource Primary}" Content="Start the backup" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Restore a backup -->
          <StackPanel x:Name="PanelRestore" Visibility="Collapsed">
            <TextBlock Text="Restore a backup (wsl --import)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ResHint" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,10"/>
            <ListBox x:Name="ResList" MaxHeight="190" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"/>
            <Button x:Name="BtnResBrowse" Style="{StaticResource Small}" Content="Browse for a .tar / .vhdx file somewhere else (e.g. a USB)..."
                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <TextBlock x:Name="ResFile" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="Name for the restored distro" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBox x:Name="ResName" FontFamily="Consolas"/>
            <TextBlock Text="Install into" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <DockPanel Margin="0,6,0,0">
              <Button x:Name="BtnResFolder" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change..." Margin="8,0,0,0"/>
              <TextBlock x:Name="ResFolder" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnResCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,10,0"/>
              <Button x:Name="BtnResOk" Style="{StaticResource Primary}" Content="Restore" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>

          <!-- Memory / CPU limits -->
          <StackPanel x:Name="PanelLimits" Visibility="Collapsed">
            <TextBlock Text="WSL resource limits (.wslconfig)" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="LimPath" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
            <Border Background="{DynamicResource LogBg}" CornerRadius="8" Padding="10,8" MaxHeight="120">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LimCurrent" FontFamily="Consolas" FontSize="12.5" Foreground="#B7C0CF" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
            <UniformGrid Columns="3" Margin="0,14,0,0">
              <Button x:Name="BtnLimLight"  Style="{StaticResource Btn}" Margin="0,0,6,0" Content="Light: 4 GB, 2 CPUs, 2 GB swap"/>
              <Button x:Name="BtnLimMedium" Style="{StaticResource Btn}" Margin="3,0" Content="Balanced: 8 GB, 4 CPUs, 4 GB swap"/>
              <Button x:Name="BtnLimHeavy"  Style="{StaticResource Btn}" Margin="6,0,0,0" Content="Heavy: 16 GB, 6 CPUs, 8 GB swap"/>
            </UniformGrid>
            <TextBlock Text="Custom values" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,6,0"><TextBlock Text="Memory (e.g. 6GB)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimMem"/></StackPanel>
              <StackPanel Margin="3,0"><TextBlock Text="Processors (e.g. 4)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimCpu"/></StackPanel>
              <StackPanel Margin="6,0,0,0"><TextBlock Text="Swap (e.g. 2GB, or 0)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimSwap"/></StackPanel>
            </UniformGrid>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Text="Only these three settings change; the rest of .wslconfig is kept, and a copy is saved as .wslconfig.bak. Takes effect after Shut down all."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnLimReset" Style="{StaticResource Btn}" Content="Reset to WSL's defaults" Margin="0,0,10,0"/>
              <Button x:Name="BtnLimClose" Style="{StaticResource Btn}" Content="Close" Margin="0,0,10,0"/>
              <Button x:Name="BtnLimCustom" Style="{StaticResource Primary}" Content="Save custom values"/>
            </StackPanel>
          </StackPanel>

          <!-- Data folders -->
          <StackPanel x:Name="PanelFolders" Visibility="Collapsed">
            <TextBlock Text="Where your data is saved" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="FolConfig" Style="{StaticResource MutedText}" Margin="0,6,0,14"/>
            <DockPanel>
              <Button x:Name="BtnFolLinux" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change..." VerticalAlignment="Center" Margin="8,0,0,0"/>
              <StackPanel><TextBlock Text="Linux disks (new distros)" FontWeight="SemiBold"/>
                <TextBlock x:Name="FolLinux" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
            </DockPanel>
            <Separator Margin="0,12" Background="{DynamicResource Line}"/>
            <DockPanel>
              <Button x:Name="BtnFolBackup" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change..." VerticalAlignment="Center" Margin="8,0,0,0"/>
              <StackPanel><TextBlock Text="Backups" FontWeight="SemiBold"/>
                <TextBlock x:Name="FolBackup" FontFamily="Consolas" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                       Text="A change only applies to NEW distros and NEW backups; existing ones stay where they are."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <Button x:Name="BtnFolDefaults" Style="{StaticResource Btn}" Content="Put both back to the defaults" Margin="0,0,10,0"/>
              <Button x:Name="BtnFolClose" Style="{StaticResource Primary}" Content="Close"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Toast -->
    <Border x:Name="Toast" Grid.ColumnSpan="2" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,20" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Ok}" BorderThickness="4,1,1,1"
            CornerRadius="10" Padding="14,10" MinWidth="260" MaxWidth="560">
      <TextBlock x:Name="ToastText" Text="" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
