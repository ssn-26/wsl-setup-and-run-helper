<!-- WSL Control Panel - the window, in the style of a Windows 11 app (like
     Settings): Fluent controls, Segoe Fluent Icons, the user's Windows accent
     colour and Mica behind the navigation pane.
     Colours are brushes in Window.Resources; every control uses them through
     DynamicResource, and WSL-Control-Panel.ps1 fills them for light or dark.
     Icons are glyphs of Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets
     (Windows 10) as fallback, written as &#x....; so this file stays ASCII.
     Every x:Name is reachable from the script as $ui.<Name>. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Control Panel" Width="1180" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Theme brushes (values are set by the script) -->
    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="Sidebar" Color="Transparent"/>
    <SolidColorBrush x:Key="LayerFill" Color="#4C3A3A3A"/>
    <SolidColorBrush x:Key="Card" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#19000000"/>
    <SolidColorBrush x:Key="ControlFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="InputActive" Color="#B31E1E1E"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleSelected" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Raised" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="Tertiary" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#47B1E8"/>
    <SolidColorBrush x:Key="AccentInk" Color="#000000"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#334CC2FF"/>
    <SolidColorBrush x:Key="Ok" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="OkSoft" Color="#393D1B"/>
    <SolidColorBrush x:Key="Warn" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#433519"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#442726"/>
    <SolidColorBrush x:Key="DangerFill" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Smoke" Color="#4D000000"/>
    <SolidColorBrush x:Key="DialogBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DialogFooterBg" Color="#202020"/>
    <SolidColorBrush x:Key="LogBg" Color="#0C0C0C"/>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Keyboard focus ring (WPF shows it only when you move with the keyboard) -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource Text}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Standard button -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlPressed}"/>
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <!-- Accent button: the one main action of a page or dialog -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Destructive action (delete) -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- A navigation-pane row that is a button (Download, the tools) -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="12,0" Height="36" Margin="0,1">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleSelected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text inputs: Fluent box with the accent line under it when focused -->
    <Style x:Key="Input" TargetType="Control">
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,6,0,4"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <Border x:Name="line" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Margin="1,0"
                      Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource InputActive}"/>
                <Setter TargetName="line" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input}">
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <Border x:Name="line" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Margin="1,0"
                      Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource InputActive}"/>
                <Setter TargetName="line" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fluent toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="20" CornerRadius="10" Background="Transparent"
                    BorderBrush="{DynamicResource Muted}" BorderThickness="1">
              <Ellipse x:Name="knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Muted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Radio buttons (backup format) -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="20" Height="20" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{DynamicResource Muted}" StrokeThickness="1" Fill="{DynamicResource ControlFill}"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource AccentInk}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin Fluent progress bar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Height="1" VerticalAlignment="Center" Background="{DynamicResource Muted}" Opacity="0.4"/>
              <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim Fluent scroll bars in the theme colours (the stock WPF bar is
         always light grey, which stood out as a white strip in dark mode) -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" CornerRadius="3" Background="{DynamicResource Tertiary}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{DynamicResource Muted}"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{DynamicResource Muted}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" Padding="3,2">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="24"/></Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="MinHeight" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" Padding="2,3">
                  <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="24"/></Track.Thumb>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Navigation-pane rows (the distro list): accent pill when selected -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1">
              <Border x:Name="b" CornerRadius="4" Padding="12,0" MinHeight="36" Background="Transparent">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleHover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleSelected}"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Rows of the lists inside dialogs: same look, roomier -->
    <Style x:Key="ListRow" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>

    <!-- "Open as" choices: segmented-style pills -->
    <Style x:Key="Chip" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" CornerRadius="4" Padding="12,5" Margin="0,0,6,0" Background="{DynamicResource ControlFill}"
                    BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Settings-style card: icon - title + description - control -->
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="MinHeight" Value="64"/>
    </Style>
    <Style x:Key="CardIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="DockPanel.Dock" Value="Left"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="Margin" Value="0,6,0,8"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,24,0,8"/>
    </Style>
    <Style x:Key="NavHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="12,16,0,4"/>
    </Style>
    <Style x:Key="DialogTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <!-- The grey button band at the bottom of every dialog -->
    <Style x:Key="DialogFooter" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DialogFooterBg}"/>
      <Setter Property="Margin" Value="-24,24,-24,-24"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="CornerRadius" Value="0,0,8,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ======================= Title bar (like Settings) =======================
         Used when Mica is on: the app name sits in the Mica area and Windows
         draws the minimise / maximise / close buttons at the top right. -->
    <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Height="40" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="16,8,0,0">
        <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center"/>
        <TextBlock Text="WSL Control Panel" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleVersion" Text="v2.3.1" FontSize="12" Foreground="{DynamicResource Tertiary}"
                   Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- ======================= Navigation pane (over Mica) ======================= -->
    <DockPanel Grid.Row="1" Background="{DynamicResource Sidebar}">
      <StackPanel x:Name="NavTitle" DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,16,6">
        <Image x:Name="AppIcon" Width="20" Height="20" VerticalAlignment="Center"/>
        <TextBlock Text="WSL Control Panel" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="v2.3.1" FontSize="12" Foreground="{DynamicResource Tertiary}"
                   Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>

      <Button x:Name="BtnQuickOpen" DockPanel.Dock="Top" Style="{StaticResource Primary}" Margin="12,10,12,4"
              HorizontalAlignment="Stretch" ToolTip="Opens the desktop of your default distro with its first saved account">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
          <TextBlock Text="Open default desktop" Margin="8,0,0,0"/>
        </StackPanel>
      </Button>

      <!-- Shown when a newer version is on GitHub -->
      <Border x:Name="UpdateCard" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,8,12,0" Padding="14,12"
              CornerRadius="6" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="UpdateText" Text="Update available" FontWeight="SemiBold" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                     Text="Takes about a minute. Your distros, logins and settings stay as they are."/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnAppUpdate" Style="{StaticResource Primary}" Content="Update now"/>
            <Button x:Name="BtnUpdateNotes" Style="{StaticResource Btn}" Content="What's new" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,0">
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Distros" Style="{StaticResource NavHeader}"/>
          <TextBlock x:Name="NoDistros" Style="{StaticResource MutedText}" Margin="12,4" Visibility="Collapsed"
                     Text="None yet. Download one below."/>
          <ListBox x:Name="DistroList" Background="Transparent" BorderThickness="0" Padding="0"
                   ItemContainerStyle="{StaticResource NavItem}" Foreground="{DynamicResource Text}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE756;"/>
                  <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="HiddenNote" Style="{StaticResource MutedText}" Margin="12,4,12,0" Visibility="Collapsed"/>
          <Button x:Name="BtnDownload" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE710;"/>
              <TextBlock Text="Download a distro" Margin="14,0,0,0"/>
            </StackPanel>
          </Button>

          <TextBlock Text="Tools" Style="{StaticResource NavHeader}"/>
          <Button x:Name="BtnBackup" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;"/><TextBlock Text="Back up" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnRestore" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;"/><TextBlock Text="Restore a backup" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnCloseRun" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;"/><TextBlock Text="Close a running distro" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnShutdown" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;"/><TextBlock Text="Shut down WSL" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnCompactAny" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;"/><TextBlock Text="Compact a disk" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnLimits" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/><TextBlock Text="Memory and processors" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnFolders" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"/><TextBlock Text="Storage locations" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnUpdate" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE895;"/><TextBlock Text="Update WSL" Margin="14,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnTheme" Style="{StaticResource NavButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE706;"/><TextBlock x:Name="ThemeText" Text="Light theme" Margin="14,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- ======================= Content pane ======================= -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource Line}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <StackPanel x:Name="EmptyPage" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
          <Border Width="72" Height="72" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="EmptyTitle" Text="No Linux distros yet" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"
                     HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" FontSize="14" TextAlignment="Center" Margin="0,8,0,20"
                     Text="Download one from Microsoft's official list - Ubuntu is a good first choice. It takes a few minutes."/>
          <Button x:Name="BtnEmptyDownload" Style="{StaticResource Primary}" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14"/><TextBlock Text="Download a distro" Margin="8,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer x:Name="DistroPage" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="PageBody" Margin="40,28,40,40" MaxWidth="1000">
            <StackPanel.RenderTransform><TranslateTransform x:Name="PageShift"/></StackPanel.RenderTransform>
            <!-- Header card -->
            <Border Style="{StaticResource CardBox}" Padding="20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                  <Grid>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeroInitial" Visibility="Collapsed"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                  <TextBlock x:Name="HeroName" Text="Ubuntu" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             FontFamily="Segoe UI Variable Display, Segoe UI"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border x:Name="StatePill" CornerRadius="4" Padding="8,2" Background="{DynamicResource Raised}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Text="Stopped" Foreground="{DynamicResource Muted}" FontSize="12" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Border>
                    <TextBlock x:Name="HeroMeta" Text="WSL 2" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,2,0,0"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnClose" Style="{StaticResource Btn}" Margin="0,0,8,0" ToolTip="wsl --terminate: stops this distro and frees its memory">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14"/><TextBlock Text="Stop" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnTerminal" Style="{StaticResource Btn}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE756;" FontSize="14"/><TextBlock Text="Terminal" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnDesktop" Style="{StaticResource Primary}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14"/><TextBlock Text="Open desktop" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Live status (refreshed every few seconds) -->
            <UniformGrid Columns="2" Margin="0,0,0,4">
              <Border Style="{StaticResource CardBox}" Margin="0,0,2,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="14" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Disk" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="LiveDisk" Text="0 GB" Style="{StaticResource TileValue}"/>
                  <ProgressBar x:Name="LiveDiskBar" Maximum="100" Value="0"/>
                  <TextBlock x:Name="LiveDiskNote" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text=" "/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBox}" Margin="2,0,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="14" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="WSL memory (all distros)" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="LiveMem" Text="0 GB" Style="{StaticResource TileValue}"/>
                  <ProgressBar x:Name="LiveMemBar" Maximum="100" Value="0"/>
                  <TextBlock x:Name="LiveMemNote" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text=" "/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Open as -->
            <Border Style="{StaticResource CardBox}">
              <DockPanel x:Name="OpenAsRow">
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE77B;"/>
                <ListBox x:Name="OpenAsList" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                         ItemContainerStyle="{StaticResource Chip}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Open as"/>
                  <TextBlock Style="{StaticResource MutedText}" Text="The saved login that Open desktop and Terminal use"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Accounts -->
            <TextBlock Text="Accounts" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource CardBox}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8D7;"/>
                <Button x:Name="BtnAddUser" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12"/><TextBlock Text="Add account" Margin="8,0,0,0"/></StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Saved logins"/>
                  <TextBlock x:Name="NoUsers" Style="{StaticResource MutedText}" Visibility="Collapsed"
                             Text="None yet. On a fresh distro, Open desktop offers to create your user."/>
                  <TextBlock Style="{StaticResource MutedText}" Text="Used to sign in automatically. Passwords are encrypted with Windows DPAPI."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <ItemsControl x:Name="AccountList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBox}" MinHeight="56" Padding="16,8" Margin="0,0,0,4">
                    <DockPanel>
                      <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Content="Change password" Tag="{Binding Name}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="Remove" Tag="{Binding Name}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Storage and network -->
            <TextBlock Text="Storage and network" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource CardBox}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xEDA2;"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="StatDisk" Text="0 GB" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <Button x:Name="BtnOpenDiskFolder" Style="{StaticResource Btn}" Margin="0,0,8,0" ToolTip="Show the disk file in File Explorer">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14"/><TextBlock Text="Open folder" Margin="8,0,0,0"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnCompact" Style="{StaticResource Btn}" Content="Compact"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Disk"/>
                  <TextBlock x:Name="DiskPath" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Text}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                  <TextBlock Style="{StaticResource MutedText}" Text="The disk grows but never shrinks by itself. Compacting gives unused space back to Windows."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBox}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE774;"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="StatPort" Visibility="Collapsed"/>
                  <TextBox x:Name="PortBox" Width="96" Text="3390" Margin="0"/>
                  <Button x:Name="BtnPortSave" Style="{StaticResource Btn}" Content="Save" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Remote Desktop port"/>
                  <TextBlock Style="{StaticResource MutedText}" Text="1024 to 65535. Give each distro its own port to keep two desktops open at once."/>
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- System -->
            <TextBlock Text="System" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource CardBox}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE713;"/>
                <Button x:Name="BtnSystemd" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Change" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="systemd"/>
                  <TextBlock Style="{StaticResource MutedText}" Text="The Linux service manager. Turn it on for Docker, SSH, cron and databases."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource CardBox}">
              <DockPanel>
                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE74D;" Foreground="{DynamicResource Danger}"/>
                <Button x:Name="BtnDelete" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Center">
                  <TextBlock Text="Delete" Foreground="{DynamicResource Danger}"/>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Delete this distro"/>
                  <TextBlock Style="{StaticResource MutedText}" Text="Erases it and every file inside. This can't be undone, so back it up first."/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- InfoBar: quick results -->
        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="1000"
                Margin="40,16,40,0" Background="{DynamicResource OkSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="4" Padding="14,10">
          <Border.RenderTransform><TranslateTransform x:Name="ToastShift"/></Border.RenderTransform>
          <DockPanel>
            <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,12,0" VerticalAlignment="Top">
              <Ellipse x:Name="ToastIconBg" Fill="{DynamicResource Ok}"/>
              <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="10" Text="&#xE73E;"
                         Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center"/>
            </Grid>
            <Button x:Name="ToastClose" DockPanel.Dock="Right" Style="{StaticResource NavButton}" VerticalAlignment="Top" Margin="8,-6,-8,-6"
                    ToolTip="Close" AutomationProperties.Name="Close message">
              <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;"/>
            </Button>
            <TextBlock x:Name="ToastText" Text="" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ======================= Dialogs (ContentDialog style) ======================= -->
    <Grid x:Name="Overlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Smoke}">
      <Border x:Name="DialogCard" Background="{DynamicResource DialogBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              CornerRadius="8" Padding="24" Margin="32"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="DialogScale"/></Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.35" Direction="270"/>
        </Border.Effect>
        <Grid>
          <!-- Message / question with up to three buttons -->
          <StackPanel x:Name="PanelMessage" Visibility="Collapsed">
            <TextBlock x:Name="MsgTitle" Style="{StaticResource DialogTitle}"/>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <TextBlock x:Name="MsgText" TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>
            <Border Style="{StaticResource DialogFooter}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MsgB3" Style="{StaticResource Btn}" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="MsgB2" Style="{StaticResource Btn}" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="MsgB1" Style="{StaticResource Primary}" MinWidth="96"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- The tool dialogs below fill the window: each is a DockPanel with
               the title on top, the button band docked at the bottom and the
               list or log (the last child) taking all the room in between. -->

          <!-- Username + password (first user, add account, re-create, change password) -->
          <DockPanel x:Name="PanelUser" Visibility="Collapsed">
            <TextBlock x:Name="UserTitle" DockPanel.Dock="Top" Text="Create your Linux user" Style="{StaticResource DialogTitle}"/>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnUserCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnUserOk" Style="{StaticResource Primary}" Content="Create user" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock x:Name="UserIntro" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,4"/>
                <TextBlock Text="Linux username" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UName"/>
                <TextBlock x:Name="UHint" Style="{StaticResource MutedText}" Text="Lowercase letters, digits, - and _, starting with a letter"/>
                <DockPanel x:Name="CreateRow" Margin="0,16,0,0">
                  <CheckBox x:Name="CreateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="True"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Text="Also create this user in the distro"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="On for a new user: makes the Linux user with admin (sudo) rights and the desktop session. Off if the user already exists, to only remember the login."/></StackPanel>
                </DockPanel>
                <TextBlock x:Name="P1Label" Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="P1"/>
                <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="P2"/>
                <TextBlock x:Name="PHint" Style="{StaticResource MutedText}" Text=" "/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Long task with live output -->
          <DockPanel x:Name="PanelTask" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="TaskTitle" Text="Working" Style="{StaticResource DialogTitle}"/>
              <DockPanel Margin="0,12,0,8">
                <TextBlock x:Name="TaskTime" DockPanel.Dock="Right" Text="0:00" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                <TextBlock x:Name="TaskStep" Text="Starting..." Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              </DockPanel>
              <ProgressBar x:Name="TaskBar" Maximum="100" Value="0"/>
            </StackPanel>
            <TextBox x:Name="TaskLog" MinHeight="220" Margin="0,16,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="{DynamicResource LogBg}" Foreground="#CCCCCC" BorderThickness="0" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="10,8"/>
          </DockPanel>

          <!-- Delete confirmation -->
          <StackPanel x:Name="PanelDelete" Visibility="Collapsed">
            <TextBlock x:Name="DelTitle" Text="Delete?" Style="{StaticResource DialogTitle}"/>
            <Border Background="{DynamicResource DangerSoft}" CornerRadius="4" Padding="12,10" Margin="0,12,0,4">
              <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" Foreground="{DynamicResource Danger}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock TextWrapping="Wrap" Text="This permanently erases the distro and all of its files. It can't be undone."/>
              </DockPanel>
            </Border>
            <TextBlock x:Name="DelLabel" Text="Type the distro name to confirm" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DelName" FontFamily="Cascadia Mono, Consolas"/>
            <Border Style="{StaticResource DialogFooter}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDelCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnDelOk" Style="{StaticResource DangerBtn}" Content="Delete" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
          </StackPanel>


          <!-- Pick one from a list (close a running distro, compact a disk) -->
          <DockPanel x:Name="PanelPick" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="PickTitle" Style="{StaticResource DialogTitle}"/>
              <TextBlock x:Name="PickText" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,12"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PickB3" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                <Button x:Name="PickB2" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="PickB1" Style="{StaticResource Primary}" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
            <ListBox x:Name="PickList" MinHeight="120" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ListRow}" Foreground="{DynamicResource Text}"/>
          </DockPanel>

          <!-- Download a new distro -->
          <DockPanel x:Name="PanelDownload" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Download a distro" Style="{StaticResource DialogTitle}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,12"
                         Text="Choose one from Microsoft's official list, or type its name."/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDlCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnDlOk" Style="{StaticResource Primary}" Content="Download" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="DlName" FontFamily="Cascadia Mono, Consolas"/>
              <TextBlock Text="Where to store it (a folder named after it is created inside)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnDlFolder" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Choose folder" Margin="8,0,0,0"/>
                <TextBlock x:Name="DlFolder" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>
            <ListBox x:Name="OnlineList" MinHeight="120" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ListRow}" Foreground="{DynamicResource Text}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,6">
                    <TextBlock Text="{Binding Friendly}"/>
                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Muted}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Back up a distro -->
          <DockPanel x:Name="PanelBackup" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Back up a distro" Style="{StaticResource DialogTitle}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,12"
                         Text="A backup holds everything inside the distro: programs, desktop, users and files."/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBakCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnBakOk" Style="{StaticResource Primary}" Content="Back up" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
              <RadioButton x:Name="BakTar" GroupName="fmt" IsChecked="True" Margin="0,8,0,3" Content=".tar - works on any PC with WSL"/>
              <RadioButton x:Name="BakVhdx" GroupName="fmt" Content=".vhdx - faster, an exact copy of the disk"/>
              <TextBlock Text="Where to save the backup" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnBakFolder" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Choose folder" Margin="8,0,0,0"/>
                <TextBlock x:Name="BakFolder" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Border Background="{DynamicResource WarnSoft}" CornerRadius="4" Padding="12,10" Margin="0,16,0,0">
                <DockPanel>
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Warn}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                  <TextBlock x:Name="BakWarn" TextWrapping="Wrap" Text="The distro is stopped first, so an open desktop or terminal closes. Save your work."/>
                </DockPanel>
              </Border>
            </StackPanel>
            <ListBox x:Name="BakList" MinHeight="96" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ListRow}" Foreground="{DynamicResource Text}"/>
          </DockPanel>

          <!-- Restore a backup -->
          <DockPanel x:Name="PanelRestore" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Restore a backup" Style="{StaticResource DialogTitle}"/>
              <TextBlock x:Name="ResHint" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,12"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnResCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnResOk" Style="{StaticResource Primary}" Content="Restore" IsEnabled="False" MinWidth="96"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom">
              <Button x:Name="BtnResBrowse" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14"/><TextBlock Text="Browse for a file" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <TextBlock x:Name="ResFile" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="Name for the restored distro" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="ResName" FontFamily="Cascadia Mono, Consolas"/>
              <TextBlock Text="Where to store it (a folder named after it is created inside)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="BtnResFolder" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Choose folder" Margin="8,0,0,0"/>
                <TextBlock x:Name="ResFolder" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </StackPanel>
            <ListBox x:Name="ResList" MinHeight="96" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ListRow}" Foreground="{DynamicResource Text}"/>
          </DockPanel>

          <!-- Memory and processors -->
          <DockPanel x:Name="PanelLimits" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Memory and processors" Style="{StaticResource DialogTitle}"/>
              <TextBlock x:Name="LimPath" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLimReset" Style="{StaticResource Btn}" Content="Use WSL defaults" Margin="0,0,8,0"/>
                <Button x:Name="BtnLimClose" Style="{StaticResource Btn}" Content="Close" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="BtnLimCustom" Style="{StaticResource Primary}" Content="Save custom" MinWidth="96"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Text="Presets" Style="{StaticResource FieldLabel}"/>
              <UniformGrid Columns="3" Margin="0,6,0,0">
                <Button x:Name="BtnLimLight"  Style="{StaticResource Btn}" Margin="0,0,4,0" Padding="8,8">
                  <StackPanel><TextBlock Text="Light" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource MutedText}" Text="4 GB, 2 CPUs, 2 GB swap" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="BtnLimMedium" Style="{StaticResource Btn}" Margin="2,0" Padding="8,8">
                  <StackPanel><TextBlock Text="Balanced" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource MutedText}" Text="8 GB, 4 CPUs, 4 GB swap" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button x:Name="BtnLimHeavy"  Style="{StaticResource Btn}" Margin="4,0,0,0" Padding="8,8">
                  <StackPanel><TextBlock Text="Heavy" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource MutedText}" Text="16 GB, 6 CPUs, 8 GB swap" HorizontalAlignment="Center"/></StackPanel>
                </Button>
              </UniformGrid>
              <TextBlock Text="Custom" Style="{StaticResource FieldLabel}"/>
              <UniformGrid Columns="3">
                <StackPanel Margin="0,0,4,0"><TextBlock Text="Memory (e.g. 6GB)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimMem"/></StackPanel>
                <StackPanel Margin="2,0"><TextBlock Text="Processors (e.g. 4)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimCpu"/></StackPanel>
                <StackPanel Margin="4,0,0,0"><TextBlock Text="Swap (e.g. 2GB or 0)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBox x:Name="LimSwap"/></StackPanel>
              </UniformGrid>
              <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                         Text="Only these three settings change; the rest of .wslconfig is kept, with a copy saved as .wslconfig.bak. Takes effect after you shut down WSL."/>
            </StackPanel>
            <Border Background="{DynamicResource LogBg}" CornerRadius="4" Padding="10,8" MinHeight="60">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LimCurrent" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
          </DockPanel>

          <!-- Storage locations: where everything is, with Open buttons -->
          <DockPanel x:Name="PanelFolders" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Storage locations" Style="{StaticResource DialogTitle}"/>
              <TextBlock Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,12"
                         Text="New distros, backups and restores always ask where to save. This is where everything is now."/>
              <TextBlock Text="Distros" Style="{StaticResource FieldLabel}" Margin="0,4,0,6"/>
              <TextBlock x:Name="FolNoDistros" Style="{StaticResource MutedText}" Text="No distros installed." Visibility="Collapsed"/>
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnFolClose" Style="{StaticResource Primary}" Content="Done" MinWidth="96"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Text="Panel" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
              <Border Style="{StaticResource CardBox}" MinHeight="0" Padding="14,8">
                <DockPanel>
                  <Button x:Name="BtnFolBackup" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Open" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <StackPanel><TextBlock Text="Last backup folder"/>
                    <TextBlock x:Name="FolBackup" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBox}" MinHeight="0" Padding="14,8">
                <DockPanel>
                  <Button x:Name="BtnFolConfig" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Open" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <StackPanel><TextBlock Text="Settings and saved logins"/>
                    <TextBlock x:Name="FolConfig" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Always next to the panel: the encrypted passwords belong to this Windows login."/></StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="60">
              <ItemsControl x:Name="FolDistros">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBox}" MinHeight="0" Padding="14,8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Open" Tag="{Binding Path}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}"/>
                          <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
